{#
  Instagram feed via Behold (https://behold.so).
  Renders only the widget — the surrounding section/heading lives in the page,
  mirroring how partials/social-icons.njk renders only the icons.

  The feed ID is read from an optional pre-set `feedId` variable (set it before
  including to use a different Behold widget per placement), otherwise it falls
  back to site.author.social.instagram_feed_id.

  If no feed ID is configured, a styled "Follow on Instagram" link is shown so
  the section is never empty/broken.
#}
{% set feedId = feedId or (site and site.author and site.author.social and site.author.social.instagram_feed_id) %}
{% set igUser = site and site.author and site.author.social and site.author.social.instagram %}

{% if feedId %}
  <behold-widget feed-id="{{ feedId }}"></behold-widget>
  <script type="module" src="https://w.behold.so/widget.js"></script>
{% elseif igUser %}
  <div class="text-center">
    <a
      href="https://instagram.com/{{ igUser }}"
      class="btn-secondary inline-flex items-center gap-2"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-5 h-5">
        <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"></circle>
      </svg>
      Follow @{{ igUser }} on Instagram
    </a>
  </div>
{% else %}
  <div class="text-sm text-neutral-500">Instagram feed coming soon.</div>
{% endif %}
