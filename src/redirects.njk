---
pagination:
  data: redirects
  size: 1
  alias: redirect
permalink: "/go/{{ redirect.slug }}/index.html"
layout: false
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url={{ redirect.url | escape }}" />
    <link id="redirect-destination" rel="canonical" href="{{ redirect.url | escape }}" />
    <title>{{ redirect.label | escape }} | {{ site.name | escape }}</title>
    <script>
      window.location.replace(document.getElementById("redirect-destination").href);
    </script>
    <style>
      body { margin: 0; padding: 2rem; font-family: system-ui, sans-serif; color: #333; }
      main { max-width: 32rem; margin: 15vh auto; text-align: center; }
      a { color: #0b5fff; }
    </style>
  </head>
  <body>
    <main>
      <h1>{{ site.name | escape }}</h1>
      <p>Taking you to {{ redirect.label | escape }}.</p>
      <p>If you are not redirected, <a href="{{ redirect.url | escape }}">continue to {{ redirect.label | escape }}</a>.</p>
    </main>
  </body>
</html>
